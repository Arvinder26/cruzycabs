# Production business settings
SITE_URL=https://cruzycabs.co.nz
SUPPORT_EMAIL=operations@cruzycabs.co.nz
OPERATIONS_EMAIL=operations@cruzycabs.co.nz
BUSINESS_LEGAL_NAME=
BUSINESS_NZBN=
BUSINESS_GST_NUMBER=
SUPPORT_PHONE=
OPERATING_HOURS=24/7

# Set a random 64-character value. Keep stable: rotating invalidates booking links.
APP_SIGNING_SECRET=
# Explicit local development only; disabled automatically in production.
LOCAL_PREVIEW=false

# Stripe hosted Checkout. Use test keys until Stripe enables your verified business.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Enable Google Routes API and Places API (New); restrict this server key appropriately.
GOOGLE_MAPS_API_KEY=
# Optional HTTPS managed Photon provider. Public Photon supplies suggestions when Google is absent or unavailable.
PHOTON_API_URL=

# Transactional email: verify the sender domain in Resend before activation.
RESEND_API_KEY=
EMAIL_FROM=cruzycabs <operations@cruzycabs.co.nz>

# Verified email role bindings: email:driver|dispatch,email:admin,email:partner
STAFF_ROLE_BINDINGS=
# Provider scope for partner accounts: email=organisation,email=organisation
PARTNER_PROVIDER_BINDINGS=

# Random secret for POST /api/jobs if native Worker cron is not provisioned.
JOBS_SECRET=
# Staff authenticator secrets (base32), provisioned securely in each staff authenticator
STAFF_TOTP_BINDINGS=

# Vercel hosting: remote Turso SQLite and private Vercel Blob
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
